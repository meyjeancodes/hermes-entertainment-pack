# Entertainment Pack — environment configuration (example)
#
# Copy this file to ~/.hermes/.env and fill in real values. The dashboard loads
# ~/.hermes/.env automatically at startup (do NOT commit the real .env — it holds
# secrets).

# ── Apple Music ───────────────────────────────────────────────────────────────
# A MusicKit developer token (JWT) signed with your Apple Developer Team ID +
# Key ID + .p8 private key. Required for the Apple Music tab to show your
# recently played. Without it the tab shows a clean "not connected" state.
# Get one from https://developer.apple.com → Keys → MusicKit.
APPLE_MUSIC_DEVELOPER_TOKEN=

# Optional: a MusicKit user token (from MusicKit JS on the web) unlocks the
# /me/recent/played library endpoint. Without it the tab still loads but may
# show an empty list until you play something in the Music app.
APPLE_MUSIC_USER_TOKEN=

# ── Spotify ────────────────────────────────────────────────────────────────────
# Spotify does NOT use an env var — connect via `hermes auth spotify` in the CLI,
# which stores the OAuth token in the Hermes credential store.
